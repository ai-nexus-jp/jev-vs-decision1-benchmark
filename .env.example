# ==============================================================================
# Jev vs Microsoft-Decision-1 Benchmark Environment Variables
# ==============================================================================

# --- TypeSafe Jev API Configuration ---
# API Endpoint URL (TypeSafe Jev System One エンドポイント)
# ※ 'https://api.typesafe.ai' または 'https://api.typesafe.ai/v1/systemone' のどちらでも自動正規化されます
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# API Key / Bearer Token
JEV_API_KEY=your_jev_api_key_here
# Model Identifier (デフォルト: jev-latest)
# JEV_MODEL_NAME=jev-latest

# --- Microsoft-Decision-1 API Configuration ---
# API Endpoint URL (Microsoft Foundry エンドポイント)
# ※ 「詳細」タブの完全URL (末尾 /v1/systemone) でも、
#   「モデルを呼び出す」コード例の base_url (末尾 /providers/microsoft) でも、
#   どちらを貼り付けてもスクリプト側で自動的に正規化されます。
# 例1 (詳細画面): https://<your-resource-name>.services.ai.azure.com/providers/microsoft/v1/systemone
# 例2 (SDKコード): https://<your-resource-name>.services.ai.azure.com/providers/microsoft
DECISION1_API_URL=https://<your-resource-name>.services.ai.azure.com/providers/microsoft/v1/systemone
# API Key (Microsoft Foundry の キー1 または キー2)
DECISION1_API_KEY=your_decision1_api_key_here
# Deployment Name (デフォルト: decision-1)
# DECISION1_MODEL_NAME=decision-1

# --- General Settings ---
# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=15

