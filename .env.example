# ==============================================================================
# Jev vs Microsoft-Decision-1 Benchmark Environment Variables
# ==============================================================================

# --- TypeSafe Jev API Configuration ---
# API Endpoint URL (e.g., Vercel AI Gateway or direct Jev API endpoint)
JEV_API_URL=https://api.typesafe.ai/v1/decision
# API Key / Bearer Token
JEV_API_KEY=your_jev_api_key_here

# --- Microsoft-Decision-1 API Configuration ---
# API Endpoint URL (e.g., Azure AI Foundry endpoint)
DECISION1_API_URL=https://<your-resource-name>.services.ai.azure.com/models/decision-1
# API Key (api-key header or Bearer Token)
DECISION1_API_KEY=your_decision1_api_key_here

# --- General Settings ---
# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=15

